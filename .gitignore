# Python
__pycache__/
*.py[cod]
*.pyo
.env
.venv/
venv/
*.egg-info/

# Excel temporales
~$*.xlsx
~$*.xls

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Reportes generados (no versionar, solo plantillas)
automation/reports/*.pdf
automation/reports/*.xlsx

# Secrets
*.env
secrets/

# Supabase CLI (contiene pooler-url con la connection string del proyecto)
**/supabase/.temp/

# ── Artefactos de pruebas (se regeneran en cada run) ────────────────────────
# El CÓDIGO de las pruebas sí se versiona, vive en apps/web/:
#   apps/web/e2e/*.spec.ts        (Playwright)
#   apps/web/src/**/*.test.ts    (Vitest)
# Lo de abajo es solo la evidencia que Playwright produce al correr.
qa/evidence/e2e/
qa/reports/

# Excepción: qa/evidence/steps/ sí se versiona. Son screenshots numerados y
# nombrados a mano que documentan el flujo paso a paso. No son automáticos.

