# Variables para tests E2E (Playwright)
# Copia este archivo a .env.test.local y completa los valores.
# .env.test.local NUNCA se commitea (está en .gitignore).

# Mismas keys públicas que .env.local
NEXT_PUBLIC_SUPABASE_URL=https://kfovorjxwwjqzhmxchpa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key (Supabase Dashboard → Settings → API → service_role)
# SOLO para crear el usuario de prueba en E2E. Nunca se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Credenciales del usuario de prueba (se crea automáticamente en el setup)
TEST_USER_EMAIL=e2e-test@openfinancekit.local
TEST_USER_PASSWORD=ofk-e2e-test-pw-2026
